
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - VetCare</title>

    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <link rel="stylesheet"
          href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" />

    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />
</head>

<body>

<div class="app-container">

    <!-- MENÚ LATERAL -->
    <aside class="sidebar">

        <div class="sidebar-logo">
            <div class="logo-icon">
                <i class="fa-solid fa-paw"></i>
            </div>

            <div>
                <h2>VetCare</h2>
                <span>Sistema Veterinario</span>
            </div>
        </div>

        <div class="sidebar-section">
            MENÚ PRINCIPAL
        </div>

        <nav class="sidebar-menu">

            <a asp-controller="Mascotas"
               asp-action="Index"
               class="menu-item">
                <i class="fa-solid fa-house"></i>
                <span>Dashboard</span>
            </a>

            <a asp-controller="Mascotas"
               asp-action="Crear"
               class="menu-item">
                <i class="fa-solid fa-circle-plus"></i>
                <span>Registrar mascota</span>
            </a>

            <a asp-controller="Mascotas"
               asp-action="Index"
               class="menu-item">
                <i class="fa-solid fa-list"></i>
                <span>Pacientes</span>
            </a>

        </nav>

        <div class="sidebar-footer">
            <i class="fa-solid fa-shield-heart"></i>

            <div>
                <strong>VetCare</strong>
                <small>Práctica 3 - IPC2</small>
            </div>
        </div>

    </aside>

    <!-- CONTENIDO PRINCIPAL -->
    <div class="main-wrapper">

        <header class="topbar">

            <div class="topbar-title">
                <h5>Sistema de Gestión Veterinaria</h5>
                <span>Administración de pacientes</span>
            </div>

            <div class="topbar-right">
                <div class="topbar-avatar">
                    <i class="fa-solid fa-user-doctor"></i>
                </div>

                <div class="topbar-user">
                    <strong>Administrador</strong>
                    <small>Veterinaria</small>
                </div>
            </div>

        </header>

        <main class="main-content">
            @RenderBody()
        </main>

        <footer class="main-footer">
            <span>© 2026 VetCare - Sistema Veterinario</span>
            <span>IPC2 | Práctica 3</span>
        </footer>

    </div>

</div>

<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

<script src="~/js/site.js" asp-append-version="true"></script>

@await RenderSectionAsync("Scripts", required: false)

</body>
</html>
